pipeline {
    agent {label 'linux && cpu'}

    stages {
        
        stage('Prepare Python environment') {
            steps {
                sh '''
                    python3 -m venv .venv

                    .venv/bin/python -m pip install --no-cache-dir \
                        "torch==2.14.1+cpu" torchvision \
                        --index-url https://download.pytorch.org/whl/cpu

                    .venv/bin/python -m pip install --no-cache-dir \
                        ultralytics==8.4.191
                '''
            }
        }

        stage('Download trained model') {
            steps {
                // Remove old weights so they cannot mask a failed download.
                sh 'rm -f models/best.pt'
                sh 'rm -rf models/best_ncnn_model'

                copyArtifacts(
                    projectName: 'model-training-nightly',
                    selector: lastSuccessful(),
                    filter: '**/weights/best.pt',
                    target: 'models',
                    flatten: true,
                    fingerprintArtifacts: true
                )

                sh 'test -s models/best.pt'
            }
        }

        stage('Verify model loads on Pi') {
            steps {
                sh '.venv/bin/python verify_model.py'
            }
        }

        stage('Export model to NCNN') {
            steps {
                sh '''
                    .venv/bin/python -m pip install --no-cache-dir ncnn pnnx

                    .venv/bin/yolo export \
                        model=models/best.pt \
                        format=ncnn \
                        imgsz=320 \
                        batch=1 \
                        device=cpu \
                        quantize=16

                    test -s models/best_ncnn_model/model.ncnn.param
                    test -s models/best_ncnn_model/model.ncnn.bin
                '''
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: 'models/best_ncnn_model/**',
                        fingerprint: true
                    )
                }
            }
        }

        stage('Evaluate on VOC dataset') {
            steps {
                sh '''
                    .venv/bin/python -u evaluate_voc.py \
                        --model models/best_ncnn_model \
                        --samples 200 \
                        --output "$WORKSPACE/evaluation/build-$BUILD_NUMBER"
                '''
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: "evaluation/build-${env.BUILD_NUMBER}/**",
                        fingerprint: true
                    )
                }
            }
        }
    }
}
