pipeline {
    agent {label 'gpu'}

    options {
        skipDefaultCheckout()
    }

    parameters {
        string(
            name: 'TRAIN_BRANCH',
            defaultValue: 'main',
            description: 'GIT branch containing training code'
        )
    }    
    
    environment {
        VENV = '/home/jenkins-agent/venvs/model-training'
        DATASET_CACHE = '/home/jenkins-agent/dataset_cache/project2'
    }

    stages {
        stage('Checkout Training Code') {
            steps{
                deleteDir()
                git branch: params.TRAIN_BRANCH,
                    url: 'https://github.com/JeremiahYoungA/ECEN4273_P2.git'

                sh 'git log -1 --format="%h %s"'
            }
        }

        stage('Check training agent') {
            steps {
                sh '''
                    whoami
                    hostname
                    uname -m
                    python3 --version
                '''
            }
        }

        stage('Check NVIDIA GPU') {
            steps {
                sh 'nvidia-smi'
            }
        }

        stage('Prepare Python environment') {
            steps {
                sh '''
                    set -eu

                    if [ ! -x $VENV/bin/python ]; then
                        echo "Creating Python environment"
                        python3 -m venv "$VENV"
                    fi

                    $VENV/bin/python -m pip install --upgrade pip
                    $VENV/bin/python -m pip install ultralytics==8.4.191
                    $VENV/bin/python -m pip check

                '''
            }
        }

        stage('Verify PyTorch GPU') {
            steps {
                sh '$VENV/bin/python verify_gpu.py'
            }
        }

        stage('Connect dataset cache') {
            steps {
                sh '''
                    set -eu
                    mkdir -p "$DATASET_CACHE/coco" "$DATASET_CACHE/cache"
                    mkdir -p datasets

                    # Stop rather than replace anything already present.
                    if [ -e datasets/coco ] || [ -L datasets/coco ] || \
                    [ -e datasets/cache ] || [ -L datasets/cache ]; then
                        echo "datasets/coco or datasets/cache already exists; inspect before linking."
                        exit 1
                    fi

                    ln -s "$DATASET_CACHE/coco" datasets/coco
                    ln -s "$DATASET_CACHE/cache" datasets/cache
                '''
            }
        }

        stage('Prepare dataset') {
            steps {
                sh '$VENV/bin/python -u prepare_dataset.py'
            }
        }

        stage('Training test') {
            steps {
                sh '$VENV/bin/python -u train.py'
            }
            
            post {
                success {
                    sh 'test -s "runs/ci/build-$BUILD_NUMBER/weights/best.pt"'

                    sh '''
                        tar -chzf "runs/ci/build-$BUILD_NUMBER/coco-evaluation.tar.gz" \
                            -C datasets coco
                    '''

                    archiveArtifacts(
                        artifacts: "runs/ci/build-${env.BUILD_NUMBER}/**",
                        fingerprint: true
                    )
                }
            }
        }

        stage('Export models for embedded devices') {
            steps {
                sh '''
                    set -eu

                    model_dir="runs/ci/build-$BUILD_NUMBER/weights"
                    test -s "$model_dir/best.pt"

                    "$VENV/bin/python" -m pip install --no-cache-dir \
                        onnx onnxslim pnnx

                    "$VENV/bin/yolo" export \
                        model="$model_dir/best.pt" \
                        format=onnx imgsz=320 batch=1 \
                        device=cpu dynamic=False simplify=True

                    "$VENV/bin/yolo" export \
                        model="$model_dir/best.pt" \
                        format=ncnn imgsz=320 batch=1 device=cpu

                    test -s "$model_dir/best.onnx"
                    test -d "$model_dir/best_ncnn_model"
                    test -n "$(find "$model_dir/best_ncnn_model" -name '*.param' -type f -print -quit)"
                    test -n "$(find "$model_dir/best_ncnn_model" -name '*.bin' -type f -print -quit)"

                    tar -chzf "$model_dir/best_ncnn_model.tar.gz" \
                        -C "$model_dir" best_ncnn_model
                '''

                archiveArtifacts(
                    artifacts: "runs/ci/build-${env.BUILD_NUMBER}/weights/best.onnx,runs/ci/build-${env.BUILD_NUMBER}/weights/best_ncnn_model.tar.gz",
                    fingerprint: true
                )
            }
        }
    }
}
