pipeline {
    agent { label 'linux && cpu' }

    stages {
        stage('Verify Git checkout') {
            steps {
                sh '''
                    whoami
                    git log -1 --oneline
                    ls
                '''
            }
        }

        stage('Verify compilation') {
            steps {
                sh '''
                    python -m venv .venv
                    .venv/bin/python -m pip install ruff
                    .venv/bin/python -m ruff check \
                        --select E9,F63,F7,F82 \
                        webcam.py verify_gpu.py verify_model.py validate.py prepare_dataset.py
                '''
            }
        }

        stage('Download trained model') {
            steps {
                copyArtifacts(
                    projectName: 'model-training-nightly',
                    selector: lastSuccessful(),
                    filter: '**/weights/best.pt',
                    target: 'models',
                    flatten: true
                )

                sh 'test -s models/best.pt'
            }
        }
    }
}