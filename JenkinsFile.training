pipeline {
    agent {label 'gpu'}

    stages {
        stage('Check training agent') {
            steps {
                sh '''
                    whoami
                    hostname
                    uname -m
                    python3 --version
                '''
            }
        }

        stage('Check NVIDIA GPU') {
            steps {
                sh 'nvidia-smi'
            }
        }

        stage('Prepare Python environment') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/python -m pip install --upgrade pip
                    .venv/bin/python -m pip install ultralytics
                '''
            }
        }

        stage('Verify PyTorch GPU') {
            steps {
                sh '.venv/bin/python verify_gpu.py'
            }
        }

        stage('Prepare dataset') {
            steps {
                sh '.venv/bin/python prepare_dataset.py'
            }
        }

        stage('Training test') {
            steps {
                sh '''
                    .venv/bin/yolo detect train \
                        model=yolo11n.pt \
                        data=datasets/project.yaml \
                        epochs=1 \
                        imgsz=640 \
                        batch=4 \
                        device=0 \
                        workers=2 \
                        project="$WORKSPACE/runs/ci" \ \
                        name=build-$BUILD_NUMBER
                '''
            }
            post {
                success {
                    sh 'test -s "runs/ci/build-$BUILD_NUMBER/weights/best.pt"'

                    archiveArtifacts(
                        artifacts: "runs/ci/build-${env.BUILD_NUMBER}/**",
                        fingerprint: true
                    )
                }
            }
        }
    }
}