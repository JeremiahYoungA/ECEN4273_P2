pipeline {
    agent {label 'linux && cpu'}

    parameters {
        string(
            name: 'GIT_BRANCH',
            defaultValue: 'main',
            description: 'Branch containing the validation scripts',
            trim: true
        )

        string(
            name: 'MODEL_JOB',
            defaultValue: 'model-training-test',
            description: 'Jenkins job supplying the model and dataset artifacts',
            trim: true
        )

        string(
            name: 'MODEL_BUILD',
            defaultValue: 'lastSuccessfulBuild',
            description: 'Training build number, or lastSuccessfulBuild',
            trim: true
        )
    }

    options {
        skipDefaultCheckout()
    }



    stages {

        stage('Checkout selected branch') {
            steps{
                git(
                    branch: params.GIT_BRANCH,
                    url: 'https://github.com/JeremiahYoungA/ECEN4273_P2.git'
                )

                echo "Validation code branch: ${params.GIT_BRANCH}"
                echo "Model artifact job: ${params.MODEL_JOB}"
            }
        }
        
        stage('Prepare Python environment') {
            steps {
                sh '''
                    python3 -m venv .venv

                    .venv/bin/python -m pip install --no-cache-dir \
                        "torch==2.14.1+cpu" torchvision \
                        --index-url https://download.pytorch.org/whl/cpu

                    .venv/bin/python -m pip install --no-cache-dir \
                        ultralytics==8.4.191
                '''
            }
        }

        stage('Download trained model') {
            steps {
                // Remove old weights so they cannot mask a failed download.
                sh 'rm -f models/best.pt'
                sh 'rm -rf models/best_ncnn_model models/best_ncnn_model.tar.gz'
                sh 'rm -rf datasets/coco'
                sh 'rm -f models/coco-evaluation.tar.gz'

                copyArtifacts(
                    projectName: params.MODEL_JOB,
                    selector: specific(params.MODEL_BUILD),
                    filter: '**/weights/best.pt,**/weights/best_ncnn_model.tar.gz,**/coco-evaluation.tar.gz',
                    target: 'models',
                    flatten: true,
                    fingerprintArtifacts: true,
                    resultVariableSuffix: 'TRAINING'
                )

                sh '''
                    test -s models/best.pt
                    test -s models/best_ncnn_model.tar.gz
                    test -s models/coco-evaluation.tar.gz
                    tar -xzf models/best_ncnn_model.tar.gz -C models
                    test -d models/best_ncnn_model
                    mkdir -p datasets
                    tar -xzf models/coco-evaluation.tar.gz -C datasets
                '''
            }
        }

        stage('Verify model loads on Pi') {
            steps {
                sh '.venv/bin/python verify_model.py'
            }
        }

        stage('Prepare NCNN runtime') {
            steps {
                sh '''
                    .venv/bin/python -m pip install --no-cache-dir \
                        ncnn

                    test -d models/best_ncnn_model
                '''
            }

        }

        stage('Validate') {
            steps {
                sh '''
                    .venv/bin/python -u validate.py \
                        --model models/best_ncnn_model \
                        --split val \
                        --samples 100 \
                        --output "$WORKSPACE/evaluation/build-$BUILD_NUMBER"
                '''
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: "evaluation/build-${env.BUILD_NUMBER}/**",
                        fingerprint: true
                    )
                }
            }
        }
    }
}
