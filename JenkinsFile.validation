pipeline {
    agent {label 'linux && cpu'}

    stages {
        
        stage('Prepare Python environment') {
            steps {
                sh '''
                    python3 -m venv .venv

                    .venv/bin/python -m pip install --no-cache-dir \
                        "torch==2.14.1+cpu" torchvision \
                        --index-url https://download.pytorch.org/whl/cpu

                    .venv/bin/python -m pip install --no-cache-dir \
                        ultralytics==8.4.191
                '''
            }
        }

        stage('Download trained model') {
            steps {
                // Remove old weights so they cannot mask a failed download.
                sh 'rm -f models/best.pt'
                sh 'rm -rf models/best.onnx'
                sh 'rm -f models/coco-evaluation.tar.gz'

                copyArtifacts(
                    projectName: 'model-training-nightly',
                    selector: lastSuccessful(),
                    filter: '**/weights/best.pt,**/coco-evaluation.tar.gz',
                    target: 'models',
                    flatten: true,
                    fingerprintArtifacts: true
                )

                sh '''
                    test -s models/best.pt
                    test -s models/coco-evaluation.tar.gz
                    mkdir -p datasets
                    tar -xzf models/coco-evaluation.tar.gz -C datasets
                '''
            }
        }

        stage('Verify model loads on Pi') {
            steps {
                sh '.venv/bin/python verify_model.py'
            }
        }

        stage('Export model to ONNX') {
            steps {
                sh '''
                    .venv/bin/python -m pip install --no-cache-dir \
                        onnx onnxruntime onnxslim

                    .venv/bin/yolo export \
                        model=models/best.pt \
                        format=onnx \
                        imgsz=640 \
                        batch=1 \
                        device=cpu \
                        dynamic=False \
                        simplify=True

                    test -s models/best.onnx
                '''
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: 'models/best.onnx',
                        fingerprint: true
                    )
                }
            }
        }

        stage('Validate') {
            steps {
                sh '''
                    .venv/bin/python -u validate.py \
                        --model models/best.onnx \
                        --split val \
                        --samples 100 \
                        --output "$WORKSPACE/evaluation/build-$BUILD_NUMBER"
                '''
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: "evaluation/build-${env.BUILD_NUMBER}/**",
                        fingerprint: true
                    )
                }
            }
        }
    }
}
