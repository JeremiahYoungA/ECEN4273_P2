pipeline {
    agent { label 'uno-q' }

    options {
        skipDefaultCheckout()
    }

    parameters {
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Branch containing the benchmark script', trim: true)
        string(name: 'MODEL_JOB', defaultValue: 'model-training-test', description: 'Training job with exported model and dataset', trim: true)
        string(name: 'MODEL_BUILD', defaultValue: 'lastSuccessfulBuild', description: 'Training build number or lastSuccessfulBuild', trim: true)
        string(name: 'SAMPLES', defaultValue: '100', description: 'Number of validation images to benchmark', trim: true)
        string(name: 'VULKAN_DEVICE_INDEX', defaultValue: '0', description: 'NCNN Vulkan device index; check the device list in the log', trim: true)
    }

    environment {
        VENV = "${WORKSPACE}/.venv"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: params.GIT_BRANCH, url: 'https://github.com/JeremiahYoungA/ECEN4273_P2.git'
                sh 'git log -1 --format="%h %s"'
            }
        }

        stage('Prepare lightweight environment') {
            steps {
                sh '''
                    set -eu
                    python3 -m venv "$VENV"
                    "$VENV/bin/python" -m pip install --no-cache-dir --only-binary=:all: \
                        ncnn numpy pillow
                    "$VENV/bin/python" -m pip check
                    "$VENV/bin/python" -c 'import ncnn, numpy, PIL; print("NCNN:", ncnn.__file__); print("NumPy:", numpy.__version__); print("Pillow:", PIL.__version__)'
                '''
            }
        }

        stage('Download exported model and dataset') {
            steps {
                script { env.BENCH_DIR = "uno-q-benchmark/build-${env.BUILD_NUMBER}" }
                copyArtifacts(
                    projectName: params.MODEL_JOB,
                    selector: specific(params.MODEL_BUILD),
                    filter: '**/weights/best_ncnn_model.tar.gz,**/coco-evaluation.tar.gz',
                    target: "${env.BENCH_DIR}/artifacts",
                    flatten: true,
                    fingerprintArtifacts: true,
                    resultVariableSuffix: 'TRAINING'
                )
                sh '''
                    set -eu
                    test -s "$BENCH_DIR/artifacts/best_ncnn_model.tar.gz"
                    test -s "$BENCH_DIR/artifacts/coco-evaluation.tar.gz"
                    mkdir -p "$BENCH_DIR/model" "$BENCH_DIR/datasets"
                    tar -xzf "$BENCH_DIR/artifacts/best_ncnn_model.tar.gz" -C "$BENCH_DIR/model"
                    tar -xzf "$BENCH_DIR/artifacts/coco-evaluation.tar.gz" -C "$BENCH_DIR/datasets"
                    test -d "$BENCH_DIR/model/best_ncnn_model"
                    test -d "$BENCH_DIR/datasets/coco/images/val"
                    # Do not retain both compressed and extracted copies on the Uno Q.
                    rm -f "$BENCH_DIR/artifacts/best_ncnn_model.tar.gz" \
                        "$BENCH_DIR/artifacts/coco-evaluation.tar.gz"
                '''
            }
        }

        stage('Benchmark Adreno GPU') {
            steps {
                sh '''#!/usr/bin/env bash
                    set -euo pipefail
                    PYTHONUNBUFFERED=1 "$VENV/bin/python" -u benchmark_ncnn.py \
                        --model "$BENCH_DIR/model/best_ncnn_model" \
                        --images "$BENCH_DIR/datasets/coco/images/val" \
                        --samples "$SAMPLES" --device vulkan \
                        --device-index "$VULKAN_DEVICE_INDEX" \
                        --output "$BENCH_DIR/results" \
                        2>&1 | tee "$BENCH_DIR/gpu-benchmark.log"
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "uno-q-benchmark/build-${env.BUILD_NUMBER}/gpu-benchmark.log,uno-q-benchmark/build-${env.BUILD_NUMBER}/results/**", allowEmptyArchive: true
        }
    }
}
